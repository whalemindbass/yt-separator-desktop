{
  "name": "yt-separator-desktop",
  "version": "1.8.0",
  "description": "Dr.studio",
  "main": "main.js",
  "author": {
    "name": "Whale Mind",
    "email": "whalemindbass@gmail.com"
  },
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --inspect=9229",
    "test": "node test/run.js",
    "lab": "node scripts/lab.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win --publish never",
    "release": "node scripts/release.js",
    "release:minor": "node scripts/release.js minor",
    "release:major": "node scripts/release.js major",
    "release:rebuild": "node scripts/release.js --no-bump --no-git"
  },
  "devDependencies": {
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.whalemindbass.yt-separator",
    "productName": "Dr.studio",
    "copyright": "© 2026 Whale Mind",
    "asar": true,
    "asarUnpack": [
      "renderer/lib/**/*",
      "renderer/workers/**/*"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "engine-client.js",
      "renderer/**/*",
      "!**/*.map",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "vendor",
        "to": "vendor",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "engine/bin",
        "to": "engine",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}-${target}.${ext}",
      "icon": "build/icon.png",
      "signtoolOptions": {
        "publisherName": [
          "Whale Mind"
        ],
        "signingHashAlgorithms": [
          "sha256"
        ]
      },
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Dr.studio",
      "artifactName": "${productName}-Setup.${ext}"
    },
    "portable": {
      "artifactName": "${productName}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "whalemindbass",
        "repo": "yt-separator-releases",
        "releaseType": "release"
      }
    ],
    "fileAssociations": [
      {
        "ext": "yssproj",
        "name": "Dr.studio Project",
        "description": "Dr.studio 프로젝트",
        "icon": "build/yssproj.ico",
        "role": "Editor"
      },
      {
        "ext": "dsvproj",
        "name": "Dr.studio Video Project",
        "description": "Dr.studio 영상 편집 프로젝트",
        "icon": "build/yssproj.ico",
        "role": "Editor"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "music-tempo": "^1.0.3",
    "signalsmith-stretch": "^1.3.2"
  }
}
