{
  "name": "yt-separator-desktop",
  "version": "1.9.16",
  "description": "underdaw",
  "main": "main.js",
  "author": {
    "name": "Whale Mind",
    "email": "whalemindbass@gmail.com"
  },
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --inspect=9229",
    "test": "node test/run.js",
    "lab": "node scripts/lab.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win --publish never",
    "release": "node scripts/release.js",
    "release:minor": "node scripts/release.js minor",
    "release:major": "node scripts/release.js major",
    "release:rebuild": "node scripts/release.js --no-bump --no-git"
  },
  "devDependencies": {
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.whalemindbass.yt-separator",
    "productName": "underdaw",
    "copyright": "© 2026 Whale Mind",
    "asar": true,
    "asarUnpack": [
      "renderer/lib/**/*",
      "renderer/workers/**/*"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "engine-client.js",
      "renderer/**/*",
      "!**/*.map",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "vendor",
        "to": "vendor",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "engine/bin",
        "to": "engine",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "appx",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}-${target}.${ext}",
      "icon": "build/icon.png",
      "signtoolOptions": {
        "publisherName": [
          "Whale Mind"
        ],
        "signingHashAlgorithms": [
          "sha256"
        ]
      },
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "underdaw",
      "artifactName": "${productName}-Setup.${ext}"
    },
    "portable": {
      "artifactName": "${productName}.${ext}"
    },
    "appx": {
      "publish": null,
      "artifactName": "${productName}.${ext}",
      "applicationId": "underdaw",
      "identityName": "whalemind.underdaw",
      "publisher": "CN=51AED3D3-DE4B-4B20-9E12-43CA7332C115",
      "publisherDisplayName": "whalemind",
      "displayName": "underdaw",
      "backgroundColor": "#48DEB4",
      "languages": [
        "ko-KR",
        "en-US"
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "whalemindbass",
        "repo": "yt-separator-releases",
        "releaseType": "release"
      }
    ],
    "fileAssociations": [
      {
        "ext": "yssproj",
        "name": "underdaw Project",
        "description": "underdaw 프로젝트",
        "icon": "build/yssproj.ico",
        "role": "Editor"
      },
      {
        "ext": "dsvproj",
        "name": "underdaw Video Project",
        "description": "underdaw 영상 편집 프로젝트",
        "icon": "build/yssproj.ico",
        "role": "Editor"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "music-tempo": "^1.0.3",
    "signalsmith-stretch": "^1.3.2"
  }
}
